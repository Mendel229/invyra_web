SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identifiants de connexion au panel /admin
ADMIN_USERNAME=
# Hash du mot de passe (jamais en clair) — générer avec :
#   node scripts/hash-admin-password.mjs "mon-mot-de-passe"
ADMIN_PASSWORD_HASH=
# Secret utilisé pour signer le cookie de session admin (chaîne aléatoire longue, ex: openssl rand -hex 32)
ADMIN_SESSION_SECRET=
